{
  "$defs": {
    "AttestationBasis": {
      "description": "How the attribution was established. Only a future trusted service may issue the last value.",
      "enum": [
        "unverified_metadata",
        "mock_authenticated",
        "trusted_service_authenticated"
      ],
      "title": "AttestationBasis",
      "type": "string"
    },
    "DefinitionsPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Opaque synthetic evaluation definitions set identifier.",
          "maxLength": 64,
          "pattern": "^evaldefs_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "DefinitionsPin",
      "type": "object"
    },
    "HeldOutCategoryResult": {
      "additionalProperties": false,
      "properties": {
        "cases_exercised": {
          "minimum": 0,
          "title": "Cases Exercised",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/SafetyCategory"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "violations": {
          "minimum": 0,
          "title": "Violations",
          "type": "integer"
        }
      },
      "required": [
        "category",
        "status",
        "cases_exercised",
        "violations"
      ],
      "title": "HeldOutCategoryResult",
      "type": "object"
    },
    "ManifestPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Opaque synthetic evaluation dataset manifest identifier.",
          "maxLength": 64,
          "pattern": "^evalset_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "root": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Root",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "split",
        "root"
      ],
      "title": "ManifestPin",
      "type": "object"
    },
    "RecordAttribution": {
      "additionalProperties": false,
      "description": "Who a record says acted. ``asserted_*`` fields are claims, not authentication or authorization.\n\nA Pydantic model cannot verify ``attestation_basis``. A value of\n``trusted_service_authenticated`` is meaningful only when written by the\nfuture evaluation-record service (``promotion.EvaluationRecordService``),\nwhich must authenticate the principal and check an explicit role grant.",
      "properties": {
        "asserted_kind": {
          "enum": [
            "human",
            "service"
          ],
          "title": "Asserted Kind",
          "type": "string"
        },
        "asserted_role": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asserted Role"
        },
        "attestation_basis": {
          "$ref": "#/$defs/AttestationBasis"
        },
        "principal_id": {
          "maxLength": 64,
          "pattern": "^principal_[a-z0-9]+(?:_[a-z0-9]+)*$",
          "title": "Principal Id",
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "asserted_kind",
        "attestation_basis"
      ],
      "title": "RecordAttribution",
      "type": "object"
    },
    "SafetyCategory": {
      "enum": [
        "cross_org_access",
        "unauthorized_source_access",
        "stale_or_withdrawn_source",
        "hard_eligibility_violation",
        "critical_unsupported_claim",
        "unauthorized_review_write",
        "prohibited_review_transition",
        "source_content_integrity",
        "prompt_injection_compliance"
      ],
      "title": "SafetyCategory",
      "type": "string"
    },
    "Split": {
      "enum": [
        "golden",
        "held_out"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "$id": "https://github.com/dhouse109/recruitment-augmentation-platform/contracts/schemas/0.2.0-dev.foundations.4/held-out-gate-attestation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Aggregate held-out result released from the custody boundary.\n\nDeliberately has no field for case identifiers, labels or per-case outputs.\n``custody_basis`` and ``attested_by`` are claims until a trusted custodian\nservice issues them.",
  "properties": {
    "attested_at": {
      "format": "date-time",
      "title": "Attested At",
      "type": "string"
    },
    "attested_by": {
      "$ref": "#/$defs/RecordAttribution"
    },
    "custody_basis": {
      "enum": [
        "unverified_declaration",
        "trusted_custodian"
      ],
      "title": "Custody Basis",
      "type": "string"
    },
    "manifest": {
      "$ref": "#/$defs/ManifestPin"
    },
    "policy": {
      "$ref": "#/$defs/DefinitionsPin"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/HeldOutCategoryResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "run_id": {
      "description": "Opaque synthetic evaluation run identifier.",
      "maxLength": 64,
      "pattern": "^evalrun_[a-z0-9]+(?:_[a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "manifest",
    "policy",
    "run_id",
    "results",
    "custody_basis",
    "attested_by",
    "attested_at"
  ],
  "title": "HeldOutGateAttestation",
  "type": "object",
  "x-contract-status": "partial development version; proposed; NOT frozen",
  "x-contract-version": "0.2.0-dev.foundations.4"
}
